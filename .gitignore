# Data / models (never commit runtime/private data or local LLM weights)
# See file_system/bravo_data_runtime_policy.yaml for runtime data classification.
# data/private/  = customer/local/demo operational data
# data/uploads/  = user/session uploads governed by RLS
data/
models/
*.gguf
*.faiss
storage/
# Corpus BRAVO 10 (file_system/, ~118MB PDF) ĐƯỢC version để deploy khỏi phải scp lại lên VM
# (git pull là có corpus). PDF ≤19MB/file — trong hạn GitHub. Nếu corpus phình lớn về sau, chuyển
# sang Git LFS hoặc GCS (xem docs/DOCUMENT-MANAGEMENT.md). KHÔNG version tài liệu upload runtime
# (data/uploads đã bị ignore ở trên — đó là dữ liệu người dùng, không thuộc source).

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

