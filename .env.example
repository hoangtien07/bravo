# BRAVO AI Copilot — environment template. Copy to .env and fill.
# (.env is gitignored — never commit real secrets.)

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bravo:bravo@localhost:5432/bravo

# --- Auth (ADR / SECURITY-RLS) ---
JWT_SECRET=change-me-in-production
# Pepper for MCP/API token hashing (HMAC-SHA256). Set once at deploy, never rotate.
MCP_TOKEN_PEPPER=change-me-256-bit-random

# --- LLM Router (ADR-0003 hybrid; ADR-0009 model stack) ---
# Local default — OpenAI-compatible endpoint (vLLM / Ollama). Qwen2.5-32B.
LLM_LOCAL_BASE_URL=http://localhost:8001/v1
LLM_LOCAL_MODEL=Qwen2.5-32B-Instruct-AWQ
LLM_LOCAL_API_KEY=dummy

# Cloud opt-in (default OFF — egress controlled, sensitive data pinned local).
CLOUD_ENABLED=false
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

# --- Embedding (ADR-0009: bge-m3 local) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Worker / queue ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENV=local
LOG_LEVEL=INFO
# Runtime data path policy. Docker compose sets these to /app/... inside containers.
# For bare-metal/VM runs, leave empty to resolve from the current app root, or set explicitly.
# APP_ROOT=/opt/bravo
# DATA_ROOT=/opt/bravo/data
# CORPUS_ROOT=/opt/bravo/file_system
# UPLOAD_ROOT=/opt/bravo/data/uploads
# PRIVATE_DATA_ROOT=/opt/bravo/data/private
# DATA_RUNTIME_POLICY=/opt/bravo/file_system/bravo_data_runtime_policy.yaml
# CORS: origin trình duyệt được phép gọi API (phân tách bằng dấu phẩy). RỖNG ở prod (SPA
# same-origin). Dev Vite hot-reload gọi thẳng API -> đặt origin :5173.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Observability (W2.2) ---
METRICS_ENABLED=true
# OTEL_EXPORTER_ENDPOINT=http://otel-lgtm:4318/v1/traces   # rỗng = tắt tracing

# --- Rate-limit + GPU concurrency (W2.3) ---
RATE_LIMIT_PER_MINUTE=30
LLM_MAX_CONCURRENCY=2

# --- Cost tracking (W2.4) — đơn giá / 1M token (đơn vị tuỳ chọn, mặc định 0) ---
# COST_PER_1M_PROMPT_TOKENS=0.15
# COST_PER_1M_COMPLETION_TOKENS=0.60

# --- v2 (ADR-0019/0020/0021) ---
# Egress policy: hybrid (local-default, ADR-0003) | cloud_only (v2 pilot — requires CLOUD_* set)
EGRESS_POLICY=hybrid
# Agent turn token budget (raised for attachment inject) + attachment full-text cap.
# AGENT_MAX_TOKENS=120000
# ATTACHMENT_INJECT_TOKEN_CAP=50000
# Ingest inline instead of via the arq worker (tests/dev only; prod keeps false + runs worker).
# INGEST_SYNC=false
# Q9 vision OCR for scanned PDFs (needs `.[vision]` extra + a vision-capable CLOUD_MODEL).
# VISION_OCR_ENABLED=false
# VISION_MODEL=
# Q6 parent-document expansion (default on).
# RETRIEVAL_EXPAND_SECTIONS=true

# --- Frontier runtime migration (disabled by default) ---
# legacy = current constrained loop; canary = deterministic per-user rollout; openai = SDK runtime.
AGENT_RUNTIME=legacy
AGENT_RUNTIME_CANARY_PERCENT=0
# Use models provisioned for this OpenAI project. Keep them explicit: the Agents SDK's own
# default model can change between releases.
OPENAI_AGENTS_FAST_MODEL=gpt-5.4-mini
OPENAI_AGENTS_REASONING_MODEL=gpt-5.6-sol
OPENAI_AGENTS_MAX_TURNS=8
# Default false: BRAVO keeps observability in its own audit/OTel pipeline and does not export
# prompt content to the SDK trace service.
OPENAI_AGENTS_TRACE_SENSITIVE_DATA=false

# --- Optional frontier surfaces (all fail-closed by default) ---
# Realtime transport is intentionally disabled until the deployment has an approved session
# broker. Never expose CLOUD_API_KEY to the browser.
REALTIME_ENABLED=false
REALTIME_MODEL=gpt-realtime
# Computer-use can only create a reviewed proposal; it never executes an ERP/browser action.
COMPUTER_USE_ENABLED=false
# COMPUTER_USE_ALLOWED_DOMAINS=erp.example.vn,sharepoint.example.vn
# COMPUTER_USE_MAX_STEPS=8

# --- SSO/OIDC (W2.1) — Keycloak self-host federate AD/LDAP (deploy/docker-compose.keycloak.yml) ---
# OIDC_ENABLED=true
# OIDC_ISSUER=http://keycloak:8080/realms/bravo
# OIDC_CLIENT_ID=bravo
# OIDC_CLIENT_SECRET=REPLACE_ME
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
# SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-≥16-ky-tu

# =====================================================================================
# PRESET: DEMO CLOUD-ONLY (chưa có LLM local — chỉ dùng OpenAI cho cả LLM lẫn embedding)
# Bỏ comment & copy ĐÈ các biến tương ứng ở trên. ĐIỀN OPENAI KEY THẬT (sk-...).
#
# MẤU CHỐT: vì KHÔNG có LLM local, router fail-closed-to-local sẽ trỏ localhost:8001 (rỗng)
# và TREO -> "không có response". Cách chắc chắn: trỏ LUÔN "local backend" sang OpenAI để
# mọi nhánh định tuyến đều chạy (đánh đổi: ở preset demo này mọi thứ đi cloud — chấp nhận
# được vì corpus là cẩm nang KHÔNG nhạy; KHÔNG dùng preset này cho dữ liệu thật).
# =====================================================================================
# LLM_LOCAL_BASE_URL=https://api.openai.com/v1
# LLM_LOCAL_MODEL=gpt-4o-mini
# LLM_LOCAL_API_KEY=sk-REPLACE_ME
# CLOUD_ENABLED=true
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
# CLOUD_API_KEY=sk-REPLACE_ME
# DEMO_ALLOW_CLOUD_ANSWERS=true
# # Streaming token THẬT cho câu trả lời tri thức (W1.4) — bật ở demo có LLM cloud/vLLM.
# STREAM_COMPOSE_ANSWER=true
# # Embedding qua OpenAI — DIM 1536 PHẢI khớp cột Vector trong DB (set TRƯỚC khi migrate/ingest)
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_DIM=1536
# CLOUD_EMBEDDING_BASE_URL=https://api.openai.com/v1
# CLOUD_EMBEDDING_MODEL=text-embedding-3-small
# CLOUD_EMBEDDING_API_KEY=sk-REPLACE_ME
# # Rerank: tắt (hoặc 'llm') để khỏi cần model local
# RERANK_ENABLED=false
# RERANK_PROVIDER=llm
