# BRAVO AI Copilot — environment template. Copy to .env and fill.
# (.env is gitignored — never commit real secrets.)

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bravo:bravo@localhost:5432/bravo

# --- Auth (ADR / SECURITY-RLS) ---
JWT_SECRET=change-me-in-production
# Pepper for MCP/API token hashing (HMAC-SHA256). Set once at deploy, never rotate.
MCP_TOKEN_PEPPER=change-me-256-bit-random

# --- LLM Router (ADR-0003 hybrid; ADR-0009 model stack) ---
# Local default — OpenAI-compatible endpoint (vLLM / Ollama). Qwen2.5-32B.
LLM_LOCAL_BASE_URL=http://localhost:8001/v1
LLM_LOCAL_MODEL=Qwen2.5-32B-Instruct-AWQ
LLM_LOCAL_API_KEY=dummy

# Cloud opt-in (default OFF — egress controlled, sensitive data pinned local).
CLOUD_ENABLED=false
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

# --- Embedding (ADR-0009: bge-m3 local) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Worker / queue ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
ENV=local
LOG_LEVEL=INFO
# CORS: origin trình duyệt được phép gọi API (phân tách bằng dấu phẩy). RỖNG ở prod (SPA
# same-origin). Dev Vite hot-reload gọi thẳng API -> đặt origin :5173.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# =====================================================================================
# PRESET: DEMO CLOUD-ONLY (chưa có LLM local — chỉ dùng OpenAI cho cả LLM lẫn embedding)
# Bỏ comment & copy ĐÈ các biến tương ứng ở trên. ĐIỀN OPENAI KEY THẬT (sk-...).
#
# MẤU CHỐT: vì KHÔNG có LLM local, router fail-closed-to-local sẽ trỏ localhost:8001 (rỗng)
# và TREO -> "không có response". Cách chắc chắn: trỏ LUÔN "local backend" sang OpenAI để
# mọi nhánh định tuyến đều chạy (đánh đổi: ở preset demo này mọi thứ đi cloud — chấp nhận
# được vì corpus là cẩm nang KHÔNG nhạy; KHÔNG dùng preset này cho dữ liệu thật).
# =====================================================================================
# LLM_LOCAL_BASE_URL=https://api.openai.com/v1
# LLM_LOCAL_MODEL=gpt-4o-mini
# LLM_LOCAL_API_KEY=sk-REPLACE_ME
# CLOUD_ENABLED=true
# CLOUD_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
# CLOUD_API_KEY=sk-REPLACE_ME
# DEMO_ALLOW_CLOUD_ANSWERS=true
# # Streaming token THẬT cho câu trả lời tri thức (W1.4) — bật ở demo có LLM cloud/vLLM.
# STREAM_COMPOSE_ANSWER=true
# # Embedding qua OpenAI — DIM 1536 PHẢI khớp cột Vector trong DB (set TRƯỚC khi migrate/ingest)
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_DIM=1536
# CLOUD_EMBEDDING_BASE_URL=https://api.openai.com/v1
# CLOUD_EMBEDDING_MODEL=text-embedding-3-small
# CLOUD_EMBEDDING_API_KEY=sk-REPLACE_ME
# # Rerank: tắt (hoặc 'llm') để khỏi cần model local
# RERANK_ENABLED=false
# RERANK_PROVIDER=llm
